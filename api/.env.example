# Copy to api/.env. Values here are local-development defaults.
RAGGROUND_ENV=development
RAGGROUND_LOG_LEVEL=INFO

# Used when running the API directly on the host (uv run uvicorn ...).
# docker-compose overrides these with in-network hostnames.
RAGGROUND_DATABASE_URL=postgresql+asyncpg://ragground:ragground@localhost:5442/ragground
RAGGROUND_REDIS_URL=redis://localhost:6389/0

# Auth. Required outside development: generate with `openssl rand -hex 32`.
# RAGGROUND_JWT_SECRET=

# LLM: local Ollama by default (no API key needed). Make sure `ollama serve` is running.
RAGGROUND_LLM_PROVIDER=ollama
RAGGROUND_OLLAMA_BASE_URL=http://localhost:11434
RAGGROUND_LLM_MODEL=llama3.1:8b
